#!/usr/bin/with-contenv bash

# Create config directory
mkdir -p /config
chown abc:abc /config

# Create nginx run directory
mkdir -p /run/nginx

# Configure frontend API URL
# Default: window.location.origin sends API requests through the nginx reverse proxy
# Override: set VITE_BASE_API_URL env var to point at a custom API endpoint
if [ -n "${VITE_BASE_API_URL:-}" ]; then
  cat > /var/www/html/config.js <<JSEOF
window._env_ = {
  VITE_BASE_API_URL: "${VITE_BASE_API_URL}",
};
JSEOF
else
  cat > /var/www/html/config.js <<'JSEOF'
window._env_ = {
  VITE_BASE_API_URL: window.location.origin,
};
JSEOF
fi
